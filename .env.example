# Server-only — never prefix with NEXT_PUBLIC_. Powers the dev-only admin API
# routes (create/list/ban/delete users). Get it from the Supabase dashboard:
# Project Settings -> API -> service_role secret. Needed in .env.local for
# local dev AND in Vercel's project env vars for production.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
