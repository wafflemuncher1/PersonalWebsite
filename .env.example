NEXT_PUBLIC_SUPABASE_URL=https://tszbuicqgrepwofylolg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://your-deployed-url.vercel.app

# Server-only. Never prefix with NEXT_PUBLIC_ — this bypasses row-level
# security and must never reach the browser. Get it from Supabase ->
# Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (server-only secret + webhook signing secret)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the Pro plan's monthly price (Stripe Dashboard -> Product catalog).
STRIPE_PRICE_ID_PRO=price_...

# Same Pro price ID, exposed to the client just so the pricing UI can
# reference it if needed. Not sensitive — Stripe price IDs aren't secrets.
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_...
